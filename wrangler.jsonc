{
  "name": "pear-liminal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/presence"
    ]
  },
  "services": [
    {
      "binding": "MESSAGING_API",
      "service": "agent-messaging",
      "remote": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TYPING_PRESENCE",
        "class_name": "TypingPresence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TypingPresence"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
